# ══════════════════════════════════════════════════════════════════════════════
#  ARDHNARISHWAR GLOBAL ATTENDANCE PLATFORM — ENVIRONMENT TEMPLATE (.env.example)
#  Copy this file to `.env` or set these variables in your deployment dashboard.
# ══════════════════════════════════════════════════════════════════════════════

# Primary Database Engine ("mysql" or "mongodb")
DB_TYPE=mysql

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=smart_attendance
MYSQL_FALLBACK=True

# MongoDB Configuration (Fallback or Primary if DB_TYPE=mongodb)
# Cloud Atlas Example: mongodb+srv://username:password@cluster0.mongodb.net/smart_attendance
MONGO_URI=mongodb://localhost:27017/
DATABASE_NAME=smart_attendance

# Server Configuration
PORT=5000
HOST=0.0.0.0
DEBUG=False

# Core Platform Identity
PLATFORM_NAME=Ardhnarishwar Global Attendance Platform
SUPER_ADMIN_COMPANY=Ardhnarishwar Company

# Initial Bootstrap Super Administrator
SUPER_ADMIN_EMAIL=superadmin@ardhnarishwar.com
SUPER_ADMIN_MOBILE=9999999999
SUPER_ADMIN_PASS=superadmin123

# Security & Sessions
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ardhnarishwar_production_secret_key_change_me_in_production
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Geofence & Office Telemetry Defaults
DEFAULT_TIMEZONE=Asia/Kolkata
OFFICE_LAT=28.626001
OFFICE_LNG=77.378001
OFFICE_RADIUS=100
OFFICE_SUBNET=192.168.29
FACE_MATCH_TOLERANCE=0.5

# Gmail SMTP / Attendance OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
GMAIL_USER=your-gmail@gmail.com
GMAIL_PASS=your-gmail-app-password
FROM_EMAIL=info@yourdomain.com
FROM_NAME=Your Company
SMTP_TLS_REJECT_UNAUTHORIZED=true
